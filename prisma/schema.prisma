// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PARTNER
  LAWYER
  CLIENT
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  CLOSED
  ARCHIVED
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  name        String
  role        UserRole
  hourlyRate  Decimal? @db.Decimal(12, 2)
  phone       String?
  avatarUrl   String?
  clientId    String?  @unique @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  client         Client?         @relation(fields: [clientId], references: [id])
  assignedCases  Case[]         @relation("LawyerCases")
  timeLogs       TimeLog[]
  expenses       Expense[]
  invoices       Invoice[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  caseDocuments  CaseDocument[]

  @@index([role])
  @@index([clientId])
}

model Client {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String?
  address     String?
  companyName String?
  taxId       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user         User?    @relation
  cases        Case[]

  @@index([email])
}

model Case {
  id                    String     @id @default(uuid()) @db.Uuid
  caseNumber            String     @unique
  title                 String
  description           String?
  status                CaseStatus @default(OPEN)
  retainerAmount        Decimal    @default(0) @db.Decimal(12, 2)
  depositBalance        Decimal    @default(0) @db.Decimal(12, 2)
  budgetAlertThreshold  Decimal    @default(80.00) @db.Decimal(5, 2)
  clientId              String     @db.Uuid
  lawyerId              String     @db.Uuid
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  // Relations
  client         Client         @relation(fields: [clientId], references: [id])
  lawyer         User           @relation("LawyerCases", fields: [lawyerId], references: [id])
  timeLogs       TimeLog[]
  expenses       Expense[]
  invoices       Invoice[]
  caseDocuments  CaseDocument[]

  @@index([status])
  @@index([clientId])
  @@index([lawyerId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tableName String
  recordId  String
  action    String
  userId    String   @db.Uuid
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([tableName])
  @@index([userId])
  @@index([createdAt])
}

// Placeholder models for relations (will be fully defined in later phases)
model TimeLog {
  id         String  @id @default(uuid()) @db.Uuid
  caseId     String  @db.Uuid
  userId     String  @db.Uuid
  invoiceId  String? @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User     @relation(fields: [userId], references: [id])
  case   Case     @relation(fields: [caseId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
}

model Expense {
  id        String  @id @default(uuid()) @db.Uuid
  caseId    String  @db.Uuid
  invoiceId String? @db.Uuid
  createdBy String  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case     Case     @relation(fields: [caseId], references: [id])
  creator  User     @relation(fields: [createdBy], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])
}

model Invoice {
  id         String  @id @default(uuid()) @db.Uuid
  caseId     String  @db.Uuid
  createdBy  String  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  case       Case      @relation(fields: [caseId], references: [id])
  creator    User      @relation(fields: [createdBy], references: [id])
  timeLogs   TimeLog[]
  expenses   Expense[]
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CaseDocument {
  id         String   @id @default(uuid()) @db.Uuid
  caseId     String   @db.Uuid
  uploadedBy String   @db.Uuid
  createdAt  DateTime @default(now())

  case    Case @relation(fields: [caseId], references: [id])
  uploader User @relation(fields: [uploadedBy], references: [id])
}
